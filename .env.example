# --- Required ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Private key of your Somnia Tokyo (Hideki) testnet wallet — the one with your Perps Arena USDso.
# Never commit .env. Never share this key.
PRIVATE_KEY=0x
# Comma-separated Telegram user IDs allowed to control the bot (get yours from @userinfobot).
ALLOWED_TELEGRAM_USER_IDS=

# --- Optional ---
# Hideki indexer (default shown)
INDEXER_URL=https://hideki-dev.smk.somnia.host/v1/graphql
# Hard cap on the notional of any single order placed from chat, in USD
MAX_ORDER_USD=1000
# Market-order slippage bound (0.01 = 1%)
SLIPPAGE=0.01

# Risk guard
GUARD_ENABLED=true
GUARD_INTERVAL_SEC=15
# Alert when price is within this % of a position's liquidation price
GUARD_LIQ_WARN_PCT=15
# Automatically reduce exposure when the account reaches MarginCall
GUARD_AUTO_REDUCE=true
# Fraction of the largest position to cut on MarginCall (0.25 = 25%)
GUARD_REDUCE_FRACTION=0.25
